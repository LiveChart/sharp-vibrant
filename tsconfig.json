{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "lib",
    "target": "es2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "lib",
    "sourceMap": true
  },
  "include": ["./src"],
  "exclude": ["./src/test"]
}