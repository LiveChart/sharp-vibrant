{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "lib",
    "target": "es6",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "es6"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "rootDir": "./src",
    "outDir": "lib",
    "sourceMap": true
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "./src/test"
  ],
  "compileOnSave": false
}